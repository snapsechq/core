{
    "name": "@snapsechq/core",
    "version": "0.3.4",
    "description": "SnapSec Core Platform Utilities: Authentication, Authorization, RabbitMQ, and Cache",
    "type": "module",
    "main": "./src/index.cjs",
    "module": "./src/index.js",
    "exports": {
        ".": {
            "import": "./src/index.js",
            "require": "./src/index.cjs"
        },
        "./authentication": {
            "import": "./src/authentication/index.js",
            "require": "./src/authentication/index.cjs"
        },
        "./authorization": {
            "import": "./src/authorization/index.js",
            "require": "./src/authorization/index.cjs"
        },
        "./rabbitmq": {
            "import": "./src/rabbitmq/index.js",
            "require": "./src/rabbitmq/index.cjs"
        },
        "./integration": {
            "import": "./src/integration/index.js"
        },
        "./cache": {
            "import": "./src/cache/index.js",
            "require": "./src/cache/index.cjs"
        }
    },
    "files": [
        "src"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/snapsechq/core.git"
    },
    "scripts": {
        "test": "vitest run --no-watch",
        "test:watch": "vitest"
    },
    "dependencies": {
        "amqplib": "^0.10.4",
        "axios": "^1.7.9",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.21.0"
    },
    "devDependencies": {
        "vitest": "^2.1.8"
    },
    "packageManager": "pnpm@9.15.0",
    "license": "Apache-2.0"
}
